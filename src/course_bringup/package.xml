<?xml version="1.0"?>
<package format="3">
  <name>course_bringup</name>
  <version>0.0.0</version>
  <description>Launch the patrol, sensor stream and optional MCAP recorder.</description>
  <maintainer email="Sambuca72@users.noreply.github.com">Sambuca72</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>patrol</exec_depend>
  <exec_depend>turtlesim</exec_depend>
  <exec_depend>rosbag2_transport</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
